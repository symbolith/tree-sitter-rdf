@base <http://one.example/> .
BASE <http://one.example/>
@prefix p: <http://two.example/> .
PREFIX p: <http://two.example/>

# Seperate triples by highlight
<s> <o> <http://www.example.org/\u0020bar> .
<s>  <p> foo:o .
_:s <p> <0> .
<s>
  # a != :a
  a <o> ;
  :a <o> ;
  # Types in one highlight
  <p> 'foo'@foo-bar ;
  <p> 'foo'^^<http://example.org/foo> ;
  <p> 'foo'^^foo:bar ;
  # Numerics
  <p> 1 ;
  <p> -1.0 ;
  <p> 1E-1 ;
  # Weird iri references
  <p> <http://伝言.example/?user=أكرم&amp;channel=R%26D> ;
  <p> <http://www.dit.unitn.it/\u0020pavel/om2017/papers/oaei17_paper11.pdf> ;
  # String escapes
  <p> 'foo\tbar\\foo\bar' ;
  # Multiline strings
  <p> '''This is a multi-line
  literal with many quotes (""""")
  and up to two sequential apostrophes ('').''' ;
  # String with #
  <p> "foo#" ;
  # Booleans
  <p> false .
[] <p> [
        <p> 'a' ;
        <p> 'b' ;
    ] .
() <p> ( :a :b :c ) .
{:a :b :e.}
_:G {:a :b :f.}
{<http://a.example/s> <http://a.example/p> [] .}
<http://a.example/s> <http://a.example/p> p:#comment
:G {:s :p :o {| :r :z |} }
:G {
  :s :p :o {| :source [ :graph <http://host1/> ;
                        :date "2020-01-20"^^xsd:date
                      ] ;
              :source [ :graph <http://host2/> ;
                        :date "2020-12-31"^^xsd:date
                      ]
            |} .
}
PREFIX : <http://example/>

:G {
  :s :p :o .
  :x :p <<:s :p :o>> .
}
:G {:s :p <<(:s :p :o )>> .}
