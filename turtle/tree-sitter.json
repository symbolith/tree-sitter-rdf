{
  "grammars": [
    {
      "name": "turtle",
      "camelcase": "Turtle",
      "scope": "source.turtle",
      "path": "turtle",
      "file-types": [
        ".ttl"
      ],
      "injection-regex": "^turtle$"
    },
    {
      "name": "trig",
      "camelcase": "TriG",
      "scope": "source.trig",
      "path": "trig",
      "file-types": [
        ".trig"
      ],
      "injection-regex": "^trig$"
    }
  ],
  "metadata": {
    "version": "0.2.0",
    "license": "MIT",
    "description": "TriG, Turtle, N3 grammar for tree-sitter",
    "authors": [
      {
        "name": "Gordian Dziwis"
      }
    ],
    "links": {
      "repository": "git+https://github.com/BonaBeavis/tree-sitter-turtle.git"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": true,
    "kotlin": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
